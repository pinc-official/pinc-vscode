{
  "name": "pinc-lang",
  "displayName": "pinc-lang",
  "description": "The official Plugin for the PiNC Language",
  "version": "0.0.3",
  "publisher": "pinc",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinc-official/pinc-vscode.git"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:pinc"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "preview": true,
  "contributes": {
    "languages": [
      {
        "id": "pinc",
        "aliases": [
          "PINC",
          "PiNC",
          "pinc"
        ],
        "extensions": [
          ".pi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinc",
        "scopeName": "source.pi",
        "path": "./syntaxes/pinc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pinc",
        "path": "./snippets/main.json"
      },
      {
        "language": "pinc",
        "path": "./snippets/control-flow.json"
      },
      {
        "language": "pinc",
        "path": "./snippets/tags.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "publish": "vsce publish",
    "publish:prerelease": "vsce publish --pre-release",
    "package": "vsce package",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/vscode": "1.118.0",
    "@vscode/vsce": "3.9.1",
    "typescript": "6.0.3"
  }
}
